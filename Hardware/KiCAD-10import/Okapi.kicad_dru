(version 1)

# Rules that say how the Eagle board was fabricated (Andy, 2026-11-04: match the way the
# Eagle boards printed). Each names the part and the measured geometry it accepts.

# J10 is the USB-C: in the package as fabricated its own non-plated holes sit 0.18 mm
# from its VBUS and GND pads, under the board's 0.25 mm hole rule.
(rule "J10 pads against its own holes, as fabricated"
  (condition "A.Reference == 'J10' && B.Reference == 'J10'")
  (constraint hole_clearance (min 0.17mm)))

# J10's courtyard (Andy's USB-C footprint, given a standard 0.25 mm courtyard on 2026-11-11)
# reaches over R84, R85 and C22 by about 0.4 mm. The copper meets every clearance rule
# (about 0.36 mm from the shell pads), and the parts sit where the 2024 board was built.
(rule "J10 courtyard over R84, R85 and C22, as fabricated"
  (condition "A.Reference == 'J10' && (B.Reference == 'R84' || B.Reference == 'R85' || B.Reference == 'C22')")
  (constraint courtyard_clearance (min 0mm))
  (severity ignore))

# Eagle's clearances for this board (jlcpcb-2layer in Okapi.brd): 5 mil between tracks,
# between pads, and to any SMD pad, which the netclass's 0.127 mm carries; 6 mil from a
# track or a via to a through-hole pad or a via, which these four carry.
(rule "Eagle mdWirePad 6 mil: track to through-hole pad"
  (condition "A.Type == 'Track' && B.Pad_Type == 'Through-hole'")
  (constraint clearance (min 0.1524mm)))
(rule "Eagle mdWireVia 6 mil: track to via"
  (condition "A.Type == 'Track' && B.Type == 'Via'")
  (constraint clearance (min 0.1524mm)))
(rule "Eagle mdPadVia 6 mil: through-hole pad to via"
  (condition "A.Pad_Type == 'Through-hole' && B.Type == 'Via'")
  (constraint clearance (min 0.1524mm)))
(rule "Eagle mdViaVia 6 mil: via to via"
  (condition "A.Type == 'Via' && B.Type == 'Via'")
  (constraint clearance (min 0.1524mm)))
